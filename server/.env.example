# 复制为 .env 并填入真实值。.env 不进 git。

# ---- 基础 ----
# 生产：postgresql+asyncpg://personal:密码@postgres:5432/personal_agent（compose 已注入）
# 本地开发/测试：sqlite+aiosqlite:///./app.sqlite3
DATABASE_URL=sqlite+aiosqlite:///./app.sqlite3

# JWT 签名密钥：至少 32 字节随机串。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret

# ---- LLM（OpenAI 兼容接口）----
# mock 时不调外部 API，用确定性规则，适合开发测试
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# DeepSeek 示例（地址与型号需按官网核实：https://api-docs.deepseek.com）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 腾讯混元 OpenAI 兼容地址示例（需按腾讯云官网核实）
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbo

LLM_TIMEOUT_SECONDS=15

# ---- 记忆层 ----
# inmemory（测试/开发） | mem0（生产，需 pip install -r requirements-mem0.txt）
MEMORY_BACKEND=inmemory
# mem0 的 embedding 可与 LLM 不同源；DeepSeek 是否提供 embedding 接口未核实
# MEM0_EMBEDDING_BASE_URL=
# MEM0_EMBEDDING_MODEL=

# ---- 流水线 ----
DEFAULT_TIMEZONE=Asia/Shanghai
JOB_MAX_ATTEMPTS=3
# running 状态超过该秒数视为 worker 中断，任务可被回收重跑
JOB_LOCK_TIMEOUT_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=10

# ---- 部署（compose 用）----
# Caddy 对外域名
# DOMAIN=notes.example.com
# PostgreSQL 密码
# POSTGRES_PASSWORD=change-me
