# 复制为 .env 并填入真实值。.env 不进 git。

# ---- 基础 ----
# 生产：postgresql+asyncpg://personal:密码@postgres:5432/personal_agent（compose 已注入）
# 本地开发/测试：sqlite+aiosqlite:///./app.sqlite3
DATABASE_URL=sqlite+aiosqlite:///./app.sqlite3

# JWT 签名密钥：>=32 字节随机值的编码，生产（postgresql）启动时校验
# （hex >=64 字符，或 base64/base64url 解码 >=32 字节；人类可读口令会被拒）。
# 生成任选其一：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# ---- LLM（OpenAI 兼容接口）----
# mock 时不调外部 API，用确定性规则，适合开发测试。
# 生产（postgresql）下 LLM_PROVIDER=mock 会拒绝启动（不会静默回落
# MockLLM）；LLM_PROVIDER=openai 时 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
# 三者必须齐备（任何环境，缺一启动即报错）；provider 拼错也直接报错
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# DeepSeek 示例（地址与型号需按官网核实：https://api-docs.deepseek.com）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 腾讯混元 OpenAI 兼容地址示例（需按腾讯云官网核实）
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbo

LLM_TIMEOUT_SECONDS=15

# ---- 记忆层 ----
# mem0：生产后端（向量存 pgvector，与业务库同一个 PostgreSQL 实例，
# compose 已注入 DATABASE_URL；记忆抽取的 LLM 复用上面的
# LLM_BASE_URL / LLM_API_KEY / LLM_MODEL，embedding 走 OpenAI 兼容接口）。
# 需 pip install -r requirements-mem0.txt（Docker 镜像已装）。
# inmemory 只适合单进程开发/测试：uvicorn 多 worker 或独立 worker 进程
# 下各自一份内存、互相不可见且重启即丢；生产（postgresql）配置 inmemory
# 会直接拒绝启动（测试 PG 的 CI/本地可设 ALLOW_INMEMORY_IN_PROD=true 放行）
MEMORY_BACKEND=mem0
# mem0 的 embedding 可与 LLM 不同源（留空则复用 LLM_BASE_URL，
# 模型默认 text-embedding-3-small）；DeepSeek 是否提供 embedding 接口未核实
# MEM0_EMBEDDING_BASE_URL=https://api.openai.com/v1
# MEM0_EMBEDDING_MODEL=text-embedding-3-small

# ---- 流水线 ----
DEFAULT_TIMEZONE=Asia/Shanghai
JOB_MAX_ATTEMPTS=3
# running 状态超过该秒数视为 worker 中断，任务可被回收重跑
JOB_LOCK_TIMEOUT_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=10

# ---- 运行时行为 ----
# 交互文档（/docs、/redoc、/openapi.json）：生产默认关闭，本地开发设 true
ENABLE_DOCS=false
# 日志级别（worker 进程与 uvicorn --log-level）
LOG_LEVEL=info
# CORS 允许来源（逗号分隔）。留空 = 不启用 CORS：原生 App 不走浏览器跨域；
# 只有需要浏览器前端时才填，如 https://notes.example.com
# CORS_ALLOW_ORIGINS=

# ---- 部署（compose 用）----
# Caddy 对外域名
# DOMAIN=notes.example.com
# PostgreSQL 密码
# POSTGRES_PASSWORD=change-me
