# 复制为 .env 并填入真实值。.env 不进 git。

# ---- 基础 ----
# 生产（compose）：DATABASE_URL 不手工拼——compose 给各服务注入分项变量
# （PGHOST/PGUSER/PGPASSWORD/PGPORT/PGDATABASE），应用侧统一百分号编码后
# 拼接（密码含 @:/# 等字符也不会拆坏 URL，INV-16）
# 本地开发/测试：sqlite+aiosqlite:///./app.sqlite3
DATABASE_URL=sqlite+aiosqlite:///./app.sqlite3

# JWT 签名密钥：>=32 字节随机值的编码，生产（postgresql）启动时校验
# （hex >=64 字符，或 base64/base64url 解码 >=32 字节；人类可读口令会被拒）。
# 生成任选其一：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# ---- LLM（OpenAI 兼容接口）----
# mock 时不调外部 API，用确定性规则，适合开发测试。
# 生产（postgresql）下 LLM_PROVIDER=mock 会拒绝启动（不会静默回落
# MockLLM）；LLM_PROVIDER=openai 时 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
# 三者必须齐备（任何环境，缺一启动即报错），且 LLM_BASE_URL 必须是绝对的
# http/https URL（裸主机名/相对路径/含空白/非 http(s) scheme 启动即拒）；
# provider 拼错也直接报错
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# DeepSeek 示例（地址与型号需按官网核实：https://api-docs.deepseek.com）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 腾讯混元 OpenAI 兼容地址示例（需按腾讯云官网核实）
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbo

LLM_TIMEOUT_SECONDS=15

# ---- 记忆层 ----
# 本地默认 inmemory：不装额外依赖即可跑，但**只属于单进程**——uvicorn 多
# worker 或独立 worker 进程各持一份内存，worker 写的记忆在 api 的 /search
# 里搜不到。完整链路用 compose（MEMORY_BACKEND=mem0）或本机装
# requirements-mem0.txt 后改 mem0。
# 生产（postgresql）请用 mem0：向量存 pgvector（与业务库同一 PostgreSQL）。
# 选 mem0 前先 pip install -r requirements-mem0.txt（Docker 镜像已装）——
# 未安装时启动即报错（INV-10.3），不会静默退化。
# 也可 MEMORY_BACKEND=disabled 关闭记忆（检索/问答空结果，任何环境允许）。
# 生产配 inmemory 会拒绝启动；仅单进程跑 PG 测试可设
# ALLOW_INMEMORY_IN_TESTS=true（独立 worker 无论该标志都拒绝）。
MEMORY_BACKEND=inmemory
# MEMORY_BACKEND=mem0
# MEMORY_BACKEND=disabled
# mem0 的 embedding 可与 LLM 不同源（留空则复用 LLM_*）；
# MEM0_EMBEDDING_API_KEY 缺省回落 LLM_API_KEY（共源时不必重复填）。
# 设置了 MEM0_EMBEDDING_BASE_URL/API_KEY 却无可用 key → 启动拒绝（INV-10.5）。
# MEM0_EMBEDDING_BASE_URL=https://api.openai.com/v1
# MEM0_EMBEDDING_MODEL=text-embedding-3-small
# MEM0_EMBEDDING_API_KEY=
# pgvector 列维度 / embedding 请求 dimensions（缺省 1536；须为正且 <=2000，
# 对齐 HNSW opclass 上限；与 init-db 建表维度一致——改它要同时重建 mem0 集合表）
# MEM0_EMBEDDING_DIMS=1536

# ---- 流水线 ----
# 数值型配置一律「必须为正且有有限上界」（上界见 app/config.py 的
# _NUMERIC_UPPER_BOUNDS；+inf/超大整数启动即拒——下游 timedelta/超时/
# 循环会在运行期 OverflowError）
DEFAULT_TIMEZONE=Asia/Shanghai
JOB_MAX_ATTEMPTS=3
# running 状态超过该秒数视为 worker 中断，任务可被回收重跑
JOB_LOCK_TIMEOUT_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=10

# ---- 运行时行为 ----
# 交互文档（/docs、/redoc、/openapi.json）：生产默认关闭，本地开发设 true
ENABLE_DOCS=false
# 日志级别（worker 进程与 uvicorn --log-level）
LOG_LEVEL=info
# CORS 允许来源（逗号分隔）。留空 = 不启用 CORS：原生 App 不走浏览器跨域；
# 只有需要浏览器前端时才填，如 https://notes.example.com
# CORS_ALLOW_ORIGINS=

# ---- 部署（compose 用）----
# Caddy 对外域名
# DOMAIN=notes.example.com
# PostgreSQL 密码：compose 把它作为 PGPASSWORD 注入各服务，应用拼
# DATABASE_URL 时自动百分号编码（含 @:/# 等字符无需手动转义，INV-16）
# POSTGRES_PASSWORD=change-me
